# MongoDB connection strings
# FACTURATION audit database (will be auto-created on first connect)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/facturation_audit?retryWrites=true&w=majority

# SERAMAR existing database (READ-ONLY for booking imports)
SERAMAR_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/serramar?retryWrites=true&w=majority

# Server port
PORT=10000
